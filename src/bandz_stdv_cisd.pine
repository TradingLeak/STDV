// © Bandz-ICT
// Bandz-authored STDV and CISD methodology, independently implemented in Pine Script.
//
// v2 — audit pass 1 (two changes only; detection logic untouched)
//   1. Retired projections are never deleted. An invalidated (-1) or exhausted
//      (-2 status) setup loses its live drawings but leaves a dotted "ghost"
//      marker at the level where it died, so the chart can no longer filter
//      itself down to surviving setups only.
//   2. Realtime now matches reload. Anchor invalidation and -4 exhaustion are
//      finalised only on closed candles. Historical bars and the live bar are
//      both evaluated once per closed candle, so the tick sequence inside a
//      forming bar can no longer change which projections survive.

//@version=6
indicator("Bandz STDV & CISD", shorttitle="Bandz STDV", overlay=true,
     max_bars_back=256, max_lines_count=500, max_labels_count=500, max_boxes_count=500, dynamic_requests=true)

// =============================================================================
// TYPES
// =============================================================================

type Candidate
    int direction
    int referenceTime
    float referencePrice
    int firstSweepTime
    int extremeTime
    float extreme
    int extremeBar
    int startBar
    int competitionStart
    float cisd
    int cisdOriginTime
    int cisdConfirmTime
    float cisdConfirmClose
    int cisdConfirmBar
    float swing
    int swingTime
    int stage                       // 0 = wait for CISD, 1 = wait for prior-swing breach
    float liquidityImportance
    float deliveryQuality

type LayerSnapshot
    int bullRevision
    int bullWindow
    int bullConfirmTime
    int bullFirstSweepTime
    int bullA0Time
    float bullA0
    int bullA1Time
    float bullA1
    int bullCisdOriginTime
    int bullCisdConfirmTime
    float bullCisd
    int bullReferenceTime
    float bullReferencePrice
    float bullScore
    int bearRevision
    int bearWindow
    int bearConfirmTime
    int bearFirstSweepTime
    int bearA0Time
    float bearA0
    int bearA1Time
    float bearA1
    int bearCisdOriginTime
    int bearCisdConfirmTime
    float bearCisd
    int bearReferenceTime
    float bearReferencePrice
    float bearScore
    int bullPendingId
    float bullPendingCisd
    int bearPendingId
    float bearPendingCisd
    int nativeTime
    float nativeOpen
    float nativeHigh
    float nativeLow
    float nativeClose
    int bullCandidateCount
    int bearCandidateCount
    int debugReferenceHighTime
    float debugReferenceHigh
    int debugReferenceLowTime
    float debugReferenceLow

type Projection
    int layer
    int direction                  // 1 bullish, -1 bearish
    string confirmationTf
    string liquidityTf
    string competitionTf
    int competitionStart
    int revision
    int confirmationTime
    int firstSweepTime
    int anchor0Time
    float anchor0
    int anchor1Time
    float anchor1
    int cisdOriginTime
    int cisdConfirmTime
    float cisd
    int referenceTime
    float referencePrice
    string eventId
    float projectionRange
    float selectionScore
    int status                     // 0 active, 1 anchor invalidated, 2 -4 exhausted, 3 superseded
    int endTime
    int lastLifecycleTime
    int firstObjectiveHitTime      // first touch of the -2 to -2.5 objective zone (triggered at -2)
    int deepObjectiveHitTime       // first touch of -3.5; retained for lifecycle/debug context
    array<float> ratios
    array<line> ratioLines
    array<label> ratioLabels
    array<box> ratioBoxes
    box liveMinusTwoBox
    box liveMinusFourBox
    line cisdLine
    label cisdLabel
    int deadTime                   // v2: when the setup was retired (-1 / -2 status). na while active.
    float entry                    // v3: close of the confirming candle = signal entry price
    label signalLabel              // v3: BUY / SELL tag with SL and TP
    line slLine                    // v3
    line tpLine                    // v3
    line tpLine2                   // v3
    bool tpMarked                  // v3: first objective already tagged
    bool ghosted                   // v4: retired set already reduced to a ghost stub
    bool retiredPainted            // v5: retired palette already applied once

